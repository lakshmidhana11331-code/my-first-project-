            <h1>I'm <span>Dhana</span></h1>
            <h3>BCA Student</h3>
            <p>
                I am a Bachelor of Computer Applications student
                interested in technology, programming and web development.
                I enjoy learning new skills and creating projects.
            </p>
            <a href="#projects" class="btn">View My Projects</a>
        </div>

        <div class="profile">D</div>
    </section>

    <section id="about">
