
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dhana | My Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fff7fb;
            color: #382b35;
            line-height: 1.6;
        }

        header {
            background: white;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            box-shadow: 0 2px 10px #ead9e3;
        }

        header h2 {
            color: #c04d8b;
        }

        nav a {
            text-decoration: none;
            color: #382b35;
            margin: 0 10px;
            font-weight: bold;
        }

        nav a:hover {
            color: #c04d8b;
        }

        .home {
            min-height: 85vh;
            display: flex;
            justify-content: space-around;
            align-items: center;
            flex-wrap: wrap;
            padding: 50px 8%;
            gap: 30px;
        }

        .home-text {
            max-width: 550px;
        }

        .home h1 {
            font-size: 45px;
            margin: 15px 0;
        }

        .home h1 span {
            color: #c04d8b;
        }

        .home p {
            color: #71616e;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background: #c04d8b;
            color: white;
            padding: 12px 22px;
            border-radius: 8px;
            text-decoration: none;
        }

        .profile {
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: #f3d6e6;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 90px;
            color: #a43870;
            border: 6px solid white;
            box-shadow: 0 5px 25px #e7bfd4;
        }

        section {
            padding: 65px 8%;
        }

        .title {
            text-align: center;
            color: #c04d8b;
            font-size: 32px;
            margin-bottom: 25px;
        }

        .about-box {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 20px #f0dfe9;
            text-align: center;
        }

        .skills, .projects {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .skill, .project {
            background: white;
            padding: 25px;
            border-radius: 12px;
            width: 250px;
            text-align: center;
            box-shadow: 0 4px 15px #f0dfe9;
        }

        .skill h3, .project h3 {
            color: #c04d8b;
            margin-bottom: 10px;
        }

        .project p {
            color: #71616e;
        }

        .contact {
            text-align: center;
            background: #f9e5ef;
        }

        .contact p {
            margin: 10px 0 20px;
        }

        footer {
            text-align: center;
            padding: 20px;
            background: white;
            color: #71616e;
        }

        @media (max-width: 600px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                display: inline-block;
                margin: 5px;
            }

            .home h1 {
                font-size: 35px;
            }

            .profile {
                width: 170px;
                height: 170px;
                font-size: 70px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h2>Dhana.</h2>
        <nav>
            <a href="#home">Home</a>
            <a href="#about">About</a>
